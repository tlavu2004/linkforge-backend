# ===============================================
# LinkForge Backend — Environment Variables
# ===============================================
# Copy this file to `.env` and fill in the values.
# Used for both local development and production deployment.
# Do NOT commit your real `.env` file.
# ===============================================

# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# JWT Configuration
# IMPORTANT: Generate a secure secret key (minimum 32 characters, recommend 64 characters)
# You can use: openssl rand -base64 64
# Or you can get one from: https://generate.plus/en/base64 (choose "length in bytes" = 64)
JWT_SECRET_KEY=
JWT_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Server Configuration
PORT=8080

# VNPay Configuration
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay-return
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Database Configuration (Local Docker PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/linkforge
DB_USERNAME=postgres
DB_PASSWORD=password

# Redis Configuration (Local Redis PostgreSQL)
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend URL (CORS & redirect)
FRONTEND_URL=http://localhost:5173

# Mail (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
